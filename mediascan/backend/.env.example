# ──────────────────────────────────────────────────────────────────────────────
# MediScan AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the filled-in .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset (or set to sqlite:///mediascan.db) for local SQLite.
# For Supabase PostgreSQL set to the "Transaction pooler" connection string
# from: Supabase dashboard → Project Settings → Database → Connection string
#
# Both postgres:// and postgresql:// schemes are accepted — the app
# rewrites postgres:// to postgresql:// automatically.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001

# ── AI Model Directory (optional) ─────────────────────────────────────────────
# Path to directory containing pre-trained PyTorch/ONNX models.
# Defaults to models/ relative to the backend directory.
MODEL_DIR=

# ── Migration script (optional) ───────────────────────────────────────────────
# Absolute or relative path to the SQLite file used by the migration script.
# Defaults to instance/mediascan.db relative to the backend directory.
# LOCAL_DB_PATH=instance/mediascan.db
